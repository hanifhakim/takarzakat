---
/**
 * Kerangka halaman kalkulator: judul, form (slot default), kartu hasil, info statis (slot "info"),
 * dock ringkasan mobile, dan dialog. Perekat JS: lib/calc-client.ts (dipanggil dari halaman).
 */
import Base from '../layouts/Base.astro';
import Dalil from './Dalil.astro';
import Dialogs from './Dialogs.astro';
import Faq from './Faq.astro';
import { FAQ } from '../data/faq';
import { SITUS } from '../data/situs';
import type { Jenis } from '../lib/jenis';
import { ACUAN } from '../lib/zakat';
import '../styles/calc.css';

interface Props {
  j: Jenis;
  title: string;
  description: string;
  awal: string; // HTML hasil awal (keadaan kosong) dari view builder
}
const { j, title, description, awal } = Astro.props;
const faq = FAQ[j.id];
const url = `${SITUS.url}/${j.slug}`;
const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'WebApplication', name: `Kalkulator ${j.judul.toLowerCase()} · ${SITUS.nama}`,
    url, description, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', inLanguage: 'id',
    isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITUS.nama, item: `${SITUS.url}/` },
      { '@type': 'ListItem', position: 2, name: j.judul, item: url },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map((t) => ({ '@type': 'Question', name: t.q, acceptedAnswer: { '@type': 'Answer', text: t.a } })),
  },
];
const tgl = new Date(ACUAN.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title={title} description={description} jsonld={jsonld} og={j.slug}>
  <section class="calc" data-calc={j.id}>
    <div class="head">
      <a class="back" href="/">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>Semua jenis zakat
      </a>
      <h1>{j.judul}</h1>
      <p class="intro">{j.intro}</p>
    </div>

    <form class="panel" id="form" novalidate aria-label={`Isian ${j.judul.toLowerCase()}`}>
      <slot />
    </form>

    <section class="result" id="hasil" tabindex="-1" aria-labelledby="hasil-h">
      <h2 id="hasil-h" class="sr-only">Hasil perhitungan</h2>
      <p id="hasil-umum" class="sr-only" aria-live="polite" aria-atomic="true"></p>
      <div id="hasil-isi" set:html={awal} />
      <div class="r-actions">
        <button class="btn" type="button" id="copyBtn">Salin rincian</button>
        <button class="btn primary" type="button" data-open="dlgLembaga">Tunaikan</button>
      </div>
      <p class="disclaimer">
        <a href="/metodologi">Cara kerja</a> · Harga emas: <span id="acuanTgl">bawaan {tgl}</span> ·
        <button class="linkbtn" type="button" data-open="dlgAcuan">ubah</button>
      </p>
    </section>

    <div class="info">
      <slot name="info" />
      <Dalil id={j.id} />
      <Faq items={faq} />
    </div>
  </section>

  <div class="dock hide" id="dock" aria-hidden="true">
    <div class="l"><small id="dockLbl">Menunggu isian</small><b id="dockAmt">Rp0</b></div>
    <button class="btn primary" type="button" id="dockBtn" tabindex="-1">Lihat rincian</button>
  </div>

  <Dialogs />
</Base>
