---
import type { Tanya } from '../data/faq';
interface Props { items: Tanya[] }
const { items } = Astro.props;
---
<section class="card faq" aria-labelledby="faq-h">
  <h2 id="faq-h">Pertanyaan umum</h2>
  {items.map((t) => (
    <details>
      <summary>{t.q}</summary>
      <p>{t.a}</p>
    </details>
  ))}
</section>

<style>
  .faq h2 { font: 600 17px/1.3 var(--f-sans); margin: 0 0 4px; }
  .faq details { border-top: 1px solid var(--line); }
  .faq details:first-of-type { border-top: 0; }
  .faq summary { padding: 14px 0; min-height: 44px; cursor: pointer; font-weight: 600; font-size: 15px; list-style-position: outside; }
  .faq p { margin: 0 0 14px; color: var(--muted); font-size: 15px; line-height: 1.6; }
</style>
