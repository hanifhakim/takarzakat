---
// Halaman per jenis zakat. Hari 1: kerangka (judul, intro, dalil). Kalkulator interaktif menyusul (Hari 2–3).
import Base from '../layouts/Base.astro';
import { JENIS } from '../lib/jenis';
import dalil from '../data/dalil.json';

export function getStaticPaths() {
  // Jenis yang sudah punya halaman kalkulator sendiri dikecualikan.
  const SUDAH = new Set(['penghasilan']);
  return JENIS.filter((j) => !SUDAH.has(j.id)).map((j) => ({ params: { slug: j.slug }, props: { j } }));
}
const { j } = Astro.props;
const d = dalil.jenis[j.id];
---
<Base title={`${j.judul} 2026 — TakarZakat`} description={`${j.intro} Lengkap dengan dalil, regulasi, dan perbedaan pendapat.`}>
  <a class="back" href="/">← Semua jenis zakat</a>
  <h1>{j.judul}</h1>
  <p class="intro">{j.intro}</p>
  <p class="soon">Kalkulator sedang dibangun.</p>

  <section class="dalil" aria-labelledby="h-dalil">
    <h2 id="h-dalil">Dasar hukum & perbedaan pendapat</h2>
    <p class="khilaf">{d.khilaf}</p>
    {d.dalil.map((x) => (
      <div class="ref">
        <p class="ar" lang="ar">{x.ar}</p>
        <p class="tr">{x.terjemah}</p>
        <p class="src">
          <a href={x.url} target="_blank" rel="noopener">{x.rujukan}</a>
          {'derajat' in x && x.derajat && <em class:list={['grade', { weak: 'lemah' in x && x.lemah }]}>{x.derajat}</em>}
        </p>
      </div>
    ))}
    <p class="src">Regulasi: {d.regulasi}</p>
  </section>
</Base>

<style>
  .back { display: inline-flex; min-height: 44px; align-items: center; color: var(--muted); text-decoration: none; font-size: 14px; }
  h1 { font: 500 clamp(26px, 6.4vw, 36px)/1.12 var(--f-serif); letter-spacing: -.015em; margin: 0 0 6px; }
  .intro { color: var(--muted); margin: 0; max-width: 52ch; }
  .soon { margin: 20px 0; padding: 12px 14px; background: var(--gold-soft); color: var(--warn-text); border-radius: var(--radius-sm); font-size: 14px; }
  .dalil { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; margin-top: 24px; max-width: 720px; }
  .dalil h2 { font-size: 16px; margin: 0 0 10px; }
  .khilaf { font-size: 14px; color: var(--muted); background: var(--sunk); border-radius: 10px; padding: 10px 12px; }
  .ref { border-bottom: 1px dashed var(--line); padding: 8px 0 14px; margin-bottom: 8px; }
  .ar { margin: 0 0 6px; }
  .tr { margin: 0 0 6px; font-size: 14px; font-style: italic; }
  .src { font-size: 12.5px; color: var(--muted); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 0; }
  .grade { font-style: normal; font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-text); }
  .grade.weak { background: var(--gold-soft); color: var(--warn-text); }
</style>
