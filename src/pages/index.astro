---
import Base from '../layouts/Base.astro';
import { JENIS } from '../lib/jenis';
import { ACUAN, NISAB_EMAS_G, rupiah } from '../lib/zakat';

const tgl = new Date(ACUAN.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base
  title="TakarZakat — Kalkulator Zakat Penghasilan, Emas, Fitrah 2026"
  description="Hitung zakat penghasilan, simpanan & emas, perdagangan, pertanian, dan fitrah. Lengkap dengan dalil dan perbedaan pendapat. Privat, dihitung di perangkatmu."
>
  <section class="home">
    <div class="left">
      <h1>Hitung zakatmu, lengkap dengan dasarnya.</h1>
      <p class="lede">Rumus terbuka, dalil dan perbedaan pendapat ditampilkan apa adanya. Kamu yang memutuskan.</p>
      <span class="privacy"><i></i>Privat: semua dihitung di perangkatmu</span>
    </div>
    <div class="right">
      <ul class="kinds">
        {JENIS.map((k) => (
          <li>
            <a class="kind" href={`/${k.slug}`}>
              <span class="kname">{k.nama}</span>
              <span class="kdesc">{k.ringkas}</span>
              <span class="ktime">{k.waktu}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          </li>
        ))}
      </ul>
      <div class="acuan">
        <h2>Harga acuan · {tgl}</h2>
        <dl>
          <dt>Emas 24K / gram</dt><dd class="num">{rupiah(ACUAN.emas24)}</dd>
          <dt>Nisab emas ({NISAB_EMAS_G} g)</dt><dd class="num">{rupiah(NISAB_EMAS_G * ACUAN.emas24)}</dd>
          <dt>Nisab penghasilan BAZNAS / bulan</dt><dd class="num">{rupiah(ACUAN.nisabPenghasilanBulanBaznas)}</dd>
          <dt>Zakat fitrah BAZNAS / jiwa</dt><dd class="num">{rupiah(ACUAN.fitrahBaznas)}</dd>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .home { display: grid; gap: 28px; padding: 18px 0 16px; }
  h1 { font: 500 clamp(30px, 7.4vw, 46px)/1.08 var(--f-serif); letter-spacing: -.02em; margin: 6px 0 12px; text-wrap: balance; }
  .lede { color: var(--muted); margin: 0; max-width: 34ch; text-wrap: pretty; }
  .privacy { display: inline-flex; gap: 8px; align-items: center; margin-top: 16px; font-size: 13px; color: var(--accent-text); background: var(--accent-soft); padding: 6px 12px; border-radius: 999px; }
  .privacy i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .kinds { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .kinds li { border-bottom: 1px solid var(--line); }
  .kind { display: grid; grid-template-columns: 1fr auto 18px; gap: 4px 14px; align-items: center; padding: 18px 4px; min-height: 64px; text-decoration: none; color: var(--ink); }
  .kind:hover .kname { color: var(--accent-text); }
  .kname { font: 600 18px/1.25 var(--f-sans); }
  .kdesc { grid-column: 1; font-size: 14px; color: var(--muted); }
  .ktime { grid-row: 1 / span 2; grid-column: 2; font-size: 12px; color: var(--muted); border: 1px solid var(--line); padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
  .kind svg { grid-row: 1 / span 2; grid-column: 3; color: var(--faint); }
  .acuan { margin-top: 24px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; }
  .acuan h2 { margin: 0 0 10px; font-size: 13px; font-weight: 600; color: var(--muted); letter-spacing: .02em; text-transform: uppercase; }
  .acuan dl { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; font-size: 14px; }
  .acuan dt { color: var(--muted); }
  .acuan dd { margin: 0; text-align: right; font-weight: 600; }
  @media (min-width: 960px) {
    .home { grid-template-columns: 1.05fr 1fr; align-items: start; gap: 64px; padding-top: 48px; }
    .left { position: sticky; top: 32px; }
  }
</style>
