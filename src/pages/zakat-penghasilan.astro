---
import Base from '../layouts/Base.astro';
import MoneyInput from '../components/MoneyInput.astro';
import Segmented from '../components/Segmented.astro';
import Dalil from '../components/Dalil.astro';
import Dialogs from '../components/Dialogs.astro';
import { JENIS } from '../lib/jenis';
import { ACUAN, NISAB_EMAS_G, rupiah } from '../lib/zakat';
import { renderHasil } from '../lib/view/penghasilan';
import '../styles/calc.css';

const j = JENIS.find((x) => x.id === 'penghasilan')!;
// Render awal (tanpa JS) = keadaan kosong, supaya tidak ada kedipan.
const awal = renderHasil({ metode: 'baznas', periode: 'bulan', gaji: 0, lain: 0, pokok: 0, utang: 0 }, ACUAN).html;
const tgl = new Date(ACUAN.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
const nisabNetto = NISAB_EMAS_G * ACUAN.emas24;
---
<Base
  title="Kalkulator Zakat Penghasilan 2026 (BAZNAS & Bersih) — TakarZakat"
  description={`Hitung zakat gaji dan profesi 2026. Nisab BAZNAS ${rupiah(ACUAN.nisabPenghasilanBulanBaznas)}/bulan, kadar 2,5%. Bandingkan metode bruto BAZNAS dan penghasilan bersih MUI/Muhammadiyah, lengkap dengan dalil.`}
>
  <section class="calc" data-calc="penghasilan">
    <div class="head">
      <a class="back" href="/">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>Semua jenis zakat
      </a>
      <h1>{j.judul}</h1>
      <p class="intro">{j.intro}</p>
    </div>

    <form class="panel" id="form" novalidate onsubmit="return false">
      <Segmented
        name="metode" legend="Metode perhitungan" nilai="baznas"
        hint="Belum yakin? Lihat perbandingan di hasil."
        opsi={[{ v: 'baznas', label: 'BAZNAS', sub: 'Bruto · emas 14K' }, { v: 'netto', label: 'Bersih', sub: 'MUI · Muhammadiyah' }]}
      />
      <Segmented name="periode" legend="Periode" nilai="bulan" opsi={[{ v: 'bulan', label: 'Per bulan' }, { v: 'tahun', label: 'Per tahun' }]} />
      <MoneyInput name="gaji" label="Gaji / penghasilan utama" hint="Sebelum dipotong apa pun" perLabel />
      <MoneyInput name="lain" label="Penghasilan lain" hint="Tunjangan, bonus, honor, freelance" perLabel />
      <div data-show="netto" hidden>
        <MoneyInput name="pokok" label="Kebutuhan pokok" hint="Makan, tempat tinggal, transportasi, pendidikan & kesehatan keluarga" perLabel />
        <MoneyInput name="utang" label="Cicilan utang jatuh tempo" hint="Hanya yang wajib dibayar pada periode ini" perLabel />
      </div>
    </form>

    <section class="result" id="hasil" tabindex="-1" aria-labelledby="hasil-h">
      <h2 id="hasil-h" class="sr-only">Hasil perhitungan</h2>
      <div id="hasil-isi" aria-live="polite" set:html={awal} />
      <div class="r-actions">
        <button class="btn" type="button" id="copyBtn">Salin rincian</button>
        <button class="btn primary" type="button" data-open="dlgLembaga">Tunaikan</button>
      </div>
      <p class="disclaimer">
        Alat bantu hitung, bukan fatwa. Harga acuan <span id="acuanTgl">{tgl}</span> ·
        <button class="linkbtn" type="button" data-open="dlgAcuan">ubah</button>
      </p>
    </section>

    <div class="info">
      <section class="card" aria-label="Cara menghitung">
        <details>
          <summary>Cara menghitung zakat penghasilan</summary>
          <div class="isi">
            <h3>Metode BAZNAS (bawaan)</h3>
            <ol>
              <li>Jumlahkan gaji dan penghasilan lain dalam sebulan, sebelum potongan.</li>
              <li>Bandingkan dengan nisab {rupiah(ACUAN.nisabPenghasilanBulanBaznas)}/bulan atau {rupiah(ACUAN.nisabPenghasilanTahunBaznas)}/tahun (SK Ketua BAZNAS 15/2026, setara 85 g emas 14 karat).</li>
              <li>Bila mencapai nisab, zakatnya 2,5% dari jumlah itu. Contoh: gaji Rp10.000.000 → Rp250.000/bulan.</li>
            </ol>
            <h3>Metode penghasilan bersih</h3>
            <ol>
              <li>Kurangi penghasilan dengan kebutuhan pokok dan cicilan jatuh tempo (Ijtima' Ulama MUI 2018).</li>
              <li>Bandingkan dengan 85 g emas 24 karat: {rupiah(nisabNetto)}/tahun atau {rupiah(Math.round(nisabNetto / 12))}/bulan (harga {tgl}).</li>
              <li>Bila mencapai nisab, zakatnya 2,5% dari penghasilan bersih.</li>
            </ol>
            <h3>Kapan dibayar?</h3>
            <p>Menurut Fatwa MUI 3/2003 dan PMA 52/2014, zakat penghasilan boleh dibayar saat menerima penghasilan. Bila belum mencapai nisab, penghasilan dikumpulkan setahun lalu dihitung ulang.</p>
          </div>
        </details>
      </section>
      <Dalil id="penghasilan" />
    </div>
  </section>

  <div class="dock hide" id="dock" aria-hidden="true">
    <div class="l"><small id="dockLbl">Menunggu isian</small><b id="dockAmt">Rp0</b></div>
    <button class="btn primary" type="button" id="dockBtn" tabindex="-1">Lihat rincian</button>
  </div>

  <Dialogs />
</Base>

<script>
  import { formatDenganKursor, formatTampil, nilaiDari } from '../lib/input';
  import { muat } from '../lib/acuan-store';
  import { renderHasil, teksSalin, type StatePenghasilan } from '../lib/view/penghasilan';

  const form = document.getElementById('form') as HTMLFormElement;
  const isi = document.getElementById('hasil-isi')!;
  const hasil = document.getElementById('hasil')!;
  const dock = document.getElementById('dock')!;
  const ANGKA = ['gaji', 'lain', 'pokok', 'utang'] as const;

  const st: StatePenghasilan = { metode: 'baznas', periode: 'bulan', gaji: 0, lain: 0, pokok: 0, utang: 0 };
  let acuan = muat();

  // Isi awal dari query (?gaji=10000000&metode=netto) — hanya dibaca, tidak pernah ditulis ke URL.
  const q = new URLSearchParams(location.search);
  for (const k of ANGKA) if (q.get(k)) st[k] = Math.max(0, nilaiDari(formatTampil(q.get(k)!)));
  if (q.get('metode') === 'netto') st.metode = 'netto';
  if (q.get('periode') === 'tahun') st.periode = 'tahun';

  function sinkronKontrol() {
    form.querySelectorAll<HTMLButtonElement>('[data-seg]').forEach((b) => {
      b.setAttribute('aria-pressed', String(st[b.dataset.seg as 'metode' | 'periode'] === b.dataset.v));
    });
    form.querySelectorAll<HTMLElement>('[data-show]').forEach((d) => { d.hidden = st.metode !== d.dataset.show; });
    form.querySelectorAll('.per-lbl').forEach((s) => { s.textContent = st.periode === 'bulan' ? 'per bulan' : 'per tahun'; });
  }

  let dockAktif = false;
  function perbarui() {
    sinkronKontrol();
    const { html, ring } = renderHasil(st, acuan);
    isi.innerHTML = html;
    document.getElementById('dockAmt')!.textContent = ring.angka;
    document.getElementById('dockLbl')!.textContent = `${ring.status} · ${ring.per}`;
    dockAktif = !ring.kosong;
    aturDock();
  }

  // Input angka: format saat mengetik, kursor tetap.
  for (const k of ANGKA) {
    const el = form.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!;
    if (st[k]) el.value = formatTampil(String(st[k]));
    el.addEventListener('input', () => {
      const { value, kursor } = formatDenganKursor(el.value, el.selectionStart ?? el.value.length);
      el.value = value;
      if (document.activeElement === el) el.setSelectionRange(kursor, kursor);
      st[k] = nilaiDari(value);
      perbarui();
    });
  }

  form.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-seg]');
    if (!b) return;
    (st as unknown as Record<string, string>)[b.dataset.seg!] = b.dataset.v!;
    perbarui();
  });

  // Kartu perbandingan → ganti metode.
  isi.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cmp]');
    if (!b) return;
    st.metode = b.dataset.cmp as StatePenghasilan['metode'];
    perbarui();
  });

  const tglEl = document.getElementById('acuanTgl')!;
  const tglBawaan = tglEl.textContent!;
  const labelAcuan = () => { tglEl.textContent = acuan.diubah ? 'diubah manual' : tglBawaan; };
  window.addEventListener('takar:acuan', () => { acuan = muat(); labelAcuan(); perbarui(); });
  labelAcuan();

  // Salin rincian.
  function toast(m: string) {
    const t = document.getElementById('toast')!;
    t.textContent = m; t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 1800);
  }
  document.getElementById('copyBtn')!.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(teksSalin(st, acuan)); toast('Rincian disalin'); }
    catch { toast('Tidak bisa menyalin di peramban ini'); }
  });

  // Dock mobile: tampil saat ada hasil dan kartu hasil tidak terlihat.
  let hasilTerlihat = false;
  function aturDock() { dock.classList.toggle('hide', !dockAktif || hasilTerlihat); }
  new IntersectionObserver(([en]) => { hasilTerlihat = en.isIntersecting; aturDock(); }, { threshold: 0.15 }).observe(hasil);
  document.getElementById('dockBtn')!.addEventListener('click', () => {
    const halus = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    hasil.scrollIntoView({ behavior: halus ? 'smooth' : 'auto', block: 'start' });
    hasil.focus({ preventScroll: true });
  });

  perbarui();
</script>
