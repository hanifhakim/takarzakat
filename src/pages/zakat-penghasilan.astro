---
import CalcShell from '../components/CalcShell.astro';
import CaraHitung from '../components/CaraHitung.astro';
import MoneyInput from '../components/MoneyInput.astro';
import Segmented from '../components/Segmented.astro';
import { JENIS } from '../lib/jenis';
import { ACUAN, NISAB_EMAS_G, rupiah } from '../lib/zakat';
import { AWAL_PENGHASILAN, renderHasil } from '../lib/view/penghasilan';

const j = JENIS.find((x) => x.id === 'penghasilan')!;
const tgl = new Date(ACUAN.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
const nisabNetto = NISAB_EMAS_G * ACUAN.emas24;
---
<CalcShell
  j={j}
  title="Kalkulator Zakat Penghasilan 2026 (BAZNAS & Bersih) — TakarZakat"
  description={`Hitung zakat gaji dan profesi 2026. Nisab BAZNAS ${rupiah(ACUAN.nisabPenghasilanBulanBaznas)}/bulan, kadar 2,5%. Bandingkan metode bruto BAZNAS dan penghasilan bersih MUI/Muhammadiyah, lengkap dengan dalil.`}
  awal={renderHasil(AWAL_PENGHASILAN, ACUAN).html}
>
  <Segmented
    name="metode" legend="Metode perhitungan" nilai="baznas"
    hint="Belum yakin? Lihat perbandingan di hasil."
    opsi={[{ v: 'baznas', label: 'BAZNAS', sub: 'Bruto · emas 14K' }, { v: 'netto', label: 'Bersih', sub: 'MUI · Muhammadiyah' }]}
  />
  <Segmented name="periode" legend="Periode" nilai="bulan" opsi={[{ v: 'bulan', label: 'Per bulan' }, { v: 'tahun', label: 'Per tahun' }]} />
  <MoneyInput name="gaji" label="Gaji / penghasilan utama" hint="Sebelum dipotong apa pun" perLabel />
  <MoneyInput name="lain" label="Penghasilan lain" hint="Tunjangan, bonus, honor, freelance" perLabel />
  <div data-show="metode:netto" hidden>
    <MoneyInput name="pokok" label="Kebutuhan pokok" hint="Makan, tempat tinggal, transportasi, pendidikan & kesehatan keluarga" perLabel />
    <MoneyInput name="utang" label="Cicilan utang jatuh tempo" hint="Hanya yang wajib dibayar pada periode ini" perLabel />
  </div>

  <CaraHitung slot="info" judul="Cara menghitung zakat penghasilan">
    <h3>Metode BAZNAS (bawaan)</h3>
    <ol>
      <li>Jumlahkan gaji dan penghasilan lain dalam sebulan, sebelum potongan.</li>
      <li>Bandingkan dengan nisab {rupiah(ACUAN.nisabPenghasilanBulanBaznas)}/bulan atau {rupiah(ACUAN.nisabPenghasilanTahunBaznas)}/tahun (SK Ketua BAZNAS 15/2026, setara 85 g emas 14 karat).</li>
      <li>Bila mencapai nisab, zakatnya 2,5% dari jumlah itu. Contoh: gaji Rp10.000.000 → Rp250.000/bulan.</li>
    </ol>
    <h3>Metode penghasilan bersih</h3>
    <ol>
      <li>Kurangi penghasilan dengan kebutuhan pokok dan cicilan jatuh tempo (Ijtima' Ulama MUI 2018).</li>
      <li>Bandingkan dengan 85 g emas 24 karat. Kalkulator memakai harga emas dunia terkini; pada {tgl} sekitar {rupiah(ACUAN.emas24)}/gram, jadi nisabnya ±{rupiah(nisabNetto)}/tahun atau ±{rupiah(Math.round(nisabNetto / 12))}/bulan.</li>
      <li>Bila mencapai nisab, zakatnya 2,5% dari penghasilan bersih.</li>
    </ol>
    <h3>Kapan dibayar?</h3>
    <p>Menurut Fatwa MUI 3/2003 dan PMA 52/2014, zakat penghasilan boleh dibayar saat menerima penghasilan. Bila belum mencapai nisab, penghasilan dikumpulkan setahun lalu dihitung ulang.</p>
  </CaraHitung>
</CalcShell>

<script>
  import { pasang } from '../lib/calc-client';
  import { AWAL_PENGHASILAN, renderHasil, teksSalin } from '../lib/view/penghasilan';

  pasang({
    awal: AWAL_PENGHASILAN,
    render: renderHasil,
    salin: teksSalin,
    setelah: (s, form) => form.querySelectorAll('.per-lbl').forEach((el) => { el.textContent = s.periode === 'bulan' ? 'per bulan' : 'per tahun'; }),
  });
</script>
